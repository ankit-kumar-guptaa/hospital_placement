# ===== HP BASE (generated, do not hand edit) =====
# Custom error documents, carried over from the previous file.
ErrorDocument 403     /cgi-sys/403_def.html
ErrorDocument 404     /cgi-sys/404_def.html
ErrorDocument 500     /cgi-sys/500_def.html
ErrorDocument 502     /cgi-sys/502_def.html
ErrorDocument 503     /cgi-sys/503_def.html
ErrorDocument 504     /cgi-sys/504_def.html

# Compression and caching. Both feed Core Web Vitals, which is a
# ranking input, so they belong with the SEO work.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# The include files are fragments, not pages: no direct HTTP access.
# Guarded by module so it cannot 500 the site on older Apache.
<FilesMatch "^(db|pages|markets|market-page|market-nav|seo|media|htaccess|assets|header|footer|page-hero|page-faq|topbar|forms|statbar|specializations|process|solution|service|counter|testimonial|why-choose|ensure|faq|cta|slider|skeleton-loader|cookie-consent)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# ===== END HP BASE =====

# ===== HP ROUTES (generated, do not hand edit) =====
# Clean, extensionless URLs, built from include/pages.php.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# -- 0. Keep the Authorization header reachable from PHP, which is
#       what the original file did and what some hosts need.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# -- 1. Canonical host. Uncomment once you have confirmed the SSL
#       certificate covers the bare domain as well as www.
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -- 2. Old .php URLs redirect once to the clean route, so whatever
#       is already indexed carries its ranking across.
RewriteCond %{THE_REQUEST} "\s/+index.php[\s?]" [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+about.php[\s?]" [NC]
RewriteRule ^ /about [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+contact.php[\s?]" [NC]
RewriteRule ^ /contact [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+solutions.php[\s?]" [NC]
RewriteRule ^ /solutions [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+jobs.php[\s?]" [NC]
RewriteRule ^ /jobs [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+privacy-policy.php[\s?]" [NC]
RewriteRule ^ /privacy-policy [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+doctor-placement-services.php[\s?]" [NC]
RewriteRule ^ /doctor-placement-services [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+nurse-staffing-agency-india.php[\s?]" [NC]
RewriteRule ^ /nurse-staffing-agency [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+paramedical-recruitment-agency.php[\s?]" [NC]
RewriteRule ^ /paramedical-recruitment-agency [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+specialty-placement.php[\s?]" [NC]
RewriteRule ^ /specialty-placement [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+permanent-placement.php[\s?]" [NC]
RewriteRule ^ /permanent-placement [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+temporary-staffing-services.php[\s?]" [NC]
RewriteRule ^ /temporary-staffing-services [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+healthcare-recruitment-for-hospitals.php[\s?]" [NC]
RewriteRule ^ /healthcare-recruitment-for-hospitals [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+hospital-recruitment-agency-in-india.php[\s?]" [NC]
RewriteRule ^ /hospital-recruitment-agency-in-india [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+healthcare-recruitment-agency-in-uae.php[\s?]" [NC]
RewriteRule ^ /healthcare-recruitment-agency-in-uae [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+healthcare-recruitment-agency-in-usa.php[\s?]" [NC]
RewriteRule ^ /healthcare-recruitment-agency-in-usa [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+healthcare-recruitment-agency-in-europe.php[\s?]" [NC]
RewriteRule ^ /healthcare-recruitment-agency-in-europe [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+recruitment-agency-in-delhi-and-placement-consultants-in-delhi-ncr-job-placement-consultacy.php[\s?]" [NC]
RewriteRule ^ /recruitment-agency-in-delhi-ncr [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+hospital-job-consultants-delhi-ncr-india.php[\s?]" [NC]
RewriteRule ^ /hospital-job-consultants-delhi-ncr [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+placement-Agency-in-mumbai.php[\s?]" [NC]
RewriteRule ^ /placement-agency-in-mumbai [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+placement-Agency-in-hyderabad.php[\s?]" [NC]
RewriteRule ^ /placement-agency-in-hyderabad [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+placement-Agency-in-chandigarh.php[\s?]" [NC]
RewriteRule ^ /placement-agency-in-chandigarh [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+placement-Agency-in-kolkata.php[\s?]" [NC]
RewriteRule ^ /placement-agency-in-kolkata [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+placement-Agency-in-lucknow.php[\s?]" [NC]
RewriteRule ^ /placement-agency-in-lucknow [R=301,L]

# -- 3. Earlier route spellings keep working, also in one hop.
RewriteRule ^nurse-staffing-agency-india/?$ /nurse-staffing-agency [R=301,L,NC]
RewriteRule ^recruitment-agency-in-delhi-and-placement-consultants-in-delhi-ncr-job-placement-consultacy/?$ /recruitment-agency-in-delhi-ncr [R=301,L,NC]

# -- 4. Strip a trailing slash, so /contact/ and /contact are one URL.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# -- 5. Serve each clean route from its real file.
RewriteRule ^about$ about.php [L,NC]
RewriteRule ^contact$ contact.php [L,NC]
RewriteRule ^solutions$ solutions.php [L,NC]
RewriteRule ^jobs$ jobs.php [L,NC]
RewriteRule ^privacy-policy$ privacy-policy.php [L,NC]
RewriteRule ^doctor-placement-services$ doctor-placement-services.php [L,NC]
RewriteRule ^nurse-staffing-agency$ nurse-staffing-agency-india.php [L,NC]
RewriteRule ^paramedical-recruitment-agency$ paramedical-recruitment-agency.php [L,NC]
RewriteRule ^specialty-placement$ specialty-placement.php [L,NC]
RewriteRule ^permanent-placement$ permanent-placement.php [L,NC]
RewriteRule ^temporary-staffing-services$ temporary-staffing-services.php [L,NC]
RewriteRule ^healthcare-recruitment-for-hospitals$ healthcare-recruitment-for-hospitals.php [L,NC]
RewriteRule ^hospital-recruitment-agency-in-india$ hospital-recruitment-agency-in-india.php [L,NC]
RewriteRule ^healthcare-recruitment-agency-in-uae$ healthcare-recruitment-agency-in-uae.php [L,NC]
RewriteRule ^healthcare-recruitment-agency-in-usa$ healthcare-recruitment-agency-in-usa.php [L,NC]
RewriteRule ^healthcare-recruitment-agency-in-europe$ healthcare-recruitment-agency-in-europe.php [L,NC]
RewriteRule ^recruitment-agency-in-delhi-ncr$ recruitment-agency-in-delhi-and-placement-consultants-in-delhi-ncr-job-placement-consultacy.php [L,NC]
RewriteRule ^hospital-job-consultants-delhi-ncr$ hospital-job-consultants-delhi-ncr-india.php [L,NC]
RewriteRule ^placement-agency-in-mumbai$ placement-Agency-in-mumbai.php [L,NC]
RewriteRule ^placement-agency-in-hyderabad$ placement-Agency-in-hyderabad.php [L,NC]
RewriteRule ^placement-agency-in-chandigarh$ placement-Agency-in-chandigarh.php [L,NC]
RewriteRule ^placement-agency-in-kolkata$ placement-Agency-in-kolkata.php [L,NC]
RewriteRule ^placement-agency-in-lucknow$ placement-Agency-in-lucknow.php [L,NC]

# -- 6. The generated sitemap at its canonical path.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# -- 7. Generic fallback: /some-page is served from some-page.php
#       whenever that file exists. A brand new page therefore works
#       the moment it is uploaded, with no config to touch.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/.]+)/?$ $1.php [L]

# -- 8. Real files and folders are served as they are; anything
#       left over falls back to the home page.
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# ===== END HP ROUTES =====
